{
  "name": "runtime-garden-personal-tracker",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:worker": "tsx watch apps/api/src/worker.ts",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/api/worker.js",
    "build:api": "tsc -p tsconfig.api.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "db:migrate": "node ops/migrate.mjs",
    "db:status": "node ops/migrate.mjs --status",
    "db:import-sqlite": "node --experimental-sqlite ops/import-preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "sh ops/test-integration.sh",
    "test:browser": "npm run build && sh ops/test-browser.sh",
    "lint:syntax": "node --check ops/migrate.mjs && node --check ops/import-preview.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "playwright-core": "1.64.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
