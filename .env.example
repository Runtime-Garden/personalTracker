NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://tracker:local_dev_only_change_me@127.0.0.1:5432/tracker
# For Docker Compose production, generate a URL-safe hex password: openssl rand -hex 24
DB_PASSWORD=REPLACE_WITH_LONG_URL_SAFE_PASSWORD
IMAGE_TAG=1.0.0-rc.2
SETUP_TOKEN=GENERATE_A_RANDOM_48_CHARACTER_TOKEN
SESSION_DAYS=7
COOKIE_SECURE=false
TZ=Europe/Riga
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS

# Optional OAuth providers (register callback URL at your provider console):
# https://YOUR_PUBLIC_HOST/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional transactional email for password reset / verification
RESEND_API_KEY=
MAIL_FROM=

# Optional tenant-restricted Microsoft Entra OAuth (not multi-tenant common endpoint)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Use a private, persisted volume; docker compose config defaults to /app/uploads
ATTACHMENTS_DIR=/app/uploads

# Exact reverse-proxy IP/CIDR allowed to set X-Forwarded-For (e.g. the NPM container on the proxy network).
# Leave empty for direct/local use. Never use 'true'. Without it, all clients behind the proxy share one rate-limit bucket.
TRUST_PROXY=

# Name of the existing Docker network shared with Nginx Proxy Manager (docker network ls).
PROXY_NETWORK=proxy

# AI: custom OpenAI/Anthropic-compatible endpoints must be public HTTPS. To allow a self-hosted gateway on a
# private network (vLLM, LiteLLM, Ollama...), list its exact hostnames/IPs here (HTTP is then also allowed).
AI_ALLOWED_PRIVATE_HOSTS=
# Max time a decision model may take to classify a new task before the default priority is used.
AI_TRIAGE_TIMEOUT_MS=8000
